# Copy this file to .env and fill it in. .env is ignored by git: never commit a key.

# The model the Layers agent uses, as provider:model. Leave empty to run on rules only.
# Free option: a Google AI Studio key with a Flash-Lite model.
LAYERS_MODEL=
GOOGLE_API_KEY=

# Optional: LangSmith traces of every agent run (free Developer plan).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
