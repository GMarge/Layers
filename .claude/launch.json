{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "layers-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "layers-api",
      "runtimeExecutable": ".venv/bin/python",
